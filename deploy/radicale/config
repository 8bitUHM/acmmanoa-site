[server]
hosts = 0.0.0.0:5232
max_content_length = 20000000

[auth]
type = htpasswd
htpasswd_filename = /data/users
htpasswd_encryption = bcrypt
cache_logins = True

[rights]
type = owner_only
permit_delete_collection = False
permit_overwrite_collection = False

[storage]
filesystem_folder = /data/collections
